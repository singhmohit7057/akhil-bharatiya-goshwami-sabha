VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Sentry error tracking — get DSN from sentry.io (free tier available)
# Leave blank to disable Sentry in development
VITE_SENTRY_DSN=

# WARNING: VITE_SUPABASE_SERVICE_ROLE_KEY has full database access and bypasses Row Level Security.
# Never expose this key in the browser, commit it to version control, or share it publicly.
# Only use it in secure server-side environments.
# VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
